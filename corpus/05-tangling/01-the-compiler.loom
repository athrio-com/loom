import { TropePackages } from './TropePackages'
import { boundariesOf, boundaryFaults } from '#ast/TropeBoundaries'
import {
  contractsIn,
  fromCode,
  fromProduct,
  noSpecifiers,
  type Reference,
  referencesIn,
