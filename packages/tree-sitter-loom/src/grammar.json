{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "loom",
  "rules": {
    "document": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "frontmatter"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "preamble"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "section"
          }
        }
      ]
    },
    "frontmatter": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_fence_line"
        },
        {
          "type": "SYMBOL",
          "name": "frontmatter_fence"
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_field_line"
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "field"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              },
              {
                "type": "SYMBOL",
                "name": "_newline"
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_fence_line"
                },
                {
                  "type": "SYMBOL",
                  "name": "frontmatter_fence"
                },
                {
                  "type": "SYMBOL",
                  "name": "_newline"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "frontmatter_fence": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "---"
          },
          {
            "type": "PATTERN",
            "value": "[ \\t]*"
          }
        ]
      }
    },
    "field": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "key",
          "content": {
            "type": "SYMBOL",
            "name": "key"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": ":"
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "_space"
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "FIELD",
                      "name": "value",
                      "content": {
                        "type": "SYMBOL",
                        "name": "value"
                      }
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "key": {
      "type": "PATTERN",
      "value": "[^:\\r\\n]+"
    },
    "value": {
      "type": "PATTERN",
      "value": "[^ \\t\\r\\n]([^\\r\\n]*[^ \\t\\r\\n])?"
    },
    "_space": {
      "type": "PATTERN",
      "value": "[ \\t]+"
    },
    "section": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "heading"
            },
            {
              "type": "SYMBOL",
              "name": "divider"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "toc"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "preamble"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "code"
              },
              {
                "type": "SYMBOL",
                "name": "prose"
              }
            ]
          }
        }
      ]
    },
    "heading": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_heading_line"
        },
        {
          "type": "SYMBOL",
          "name": "heading_marker"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "title",
              "content": {
                "type": "SYMBOL",
                "name": "title"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_space"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "FIELD",
                    "name": "specifier",
                    "content": {
                      "type": "SYMBOL",
                      "name": "specifier"
                    }
                  },
                  {
                    "type": "FIELD",
                    "name": "sink",
                    "content": {
                      "type": "SYMBOL",
                      "name": "sink"
                    }
                  }
                ]
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_heading_rest"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "heading_marker": {
      "type": "PATTERN",
      "value": "#{1,6} "
    },
    "title": {
      "type": "PATTERN",
      "value": "[^{\\[\\r\\n]*[^{\\[\\s]"
    },
    "_heading_rest": {
      "type": "PATTERN",
      "value": "[^{\\[\\r\\n]+"
    },
    "specifier": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "FIELD",
          "name": "label",
          "content": {
            "type": "SYMBOL",
            "name": "label"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "label": {
      "type": "PATTERN",
      "value": "[a-zA-Z0-9_-]+( [a-zA-Z0-9_-]+)*"
    },
    "sink": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "FIELD",
          "name": "file",
          "content": {
            "type": "SYMBOL",
            "name": "file"
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "file": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_file_stem"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "extension",
          "content": {
            "type": "SYMBOL",
            "name": "extension"
          }
        }
      ]
    },
    "_file_stem": {
      "type": "PATTERN",
      "value": "[^\\]\\r\\n]*\\."
    },
    "extension": {
      "type": "PATTERN",
      "value": "[^\\].\\r\\n]+"
    },
    "divider": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_divider_line"
        },
        {
          "type": "SYMBOL",
          "name": "divider_marker"
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "divider_marker": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "PATTERN",
            "value": "---+"
          },
          {
            "type": "PATTERN",
            "value": "[ \\t]*"
          }
        ]
      }
    },
    "toc": {
      "type": "REPEAT1",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_toc_line"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "toc_part"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "toc_chapter"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "_toc_text"
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "SYMBOL",
            "name": "_newline"
          }
        ]
      }
    },
    "toc_part": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_toc_part_marker"
          },
          "named": true,
          "value": "heading_marker"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_toc_text"
          },
          "named": true,
          "value": "title"
        }
      ]
    },
    "toc_chapter": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_toc_number"
          },
          "named": true,
          "value": "number"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_toc_text"
          },
          "named": true,
          "value": "title"
        }
      ]
    },
    "_toc_part_marker": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "#{1,6}[ \\t]+"
        }
      }
    },
    "_toc_number": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[ \\t]*\\d+\\.[ \\t]+"
        }
      }
    },
    "_toc_text": {
      "type": "PATTERN",
      "value": "[^\\r\\n]+"
    },
    "preamble": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_prose_line"
              },
              {
                "type": "REPEAT",
                "content": {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "_text"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "_code_span"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "anchor"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "warp"
                    }
                  ]
                }
              },
              {
                "type": "SYMBOL",
                "name": "_newline"
              }
            ]
          },
          {
            "type": "SYMBOL",
            "name": "_verbatim"
          },
          {
            "type": "SYMBOL",
            "name": "box"
          }
        ]
      }
    },
    "prose": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_tilde_line"
        },
        {
          "type": "SYMBOL",
          "name": "tilde"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_prose_inline"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_prose_line"
                  },
                  {
                    "type": "REPEAT",
                    "content": {
                      "type": "SYMBOL",
                      "name": "_prose_inline"
                    }
                  },
                  {
                    "type": "SYMBOL",
                    "name": "_newline"
                  }
                ]
              },
              {
                "type": "SYMBOL",
                "name": "_verbatim"
              },
              {
                "type": "SYMBOL",
                "name": "box"
              }
            ]
          }
        }
      ]
    },
    "tilde": {
      "type": "STRING",
      "value": "~"
    },
    "_prose_inline": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_text"
        },
        {
          "type": "SYMBOL",
          "name": "_code_span"
        },
        {
          "type": "SYMBOL",
          "name": "anchor"
        }
      ]
    },
    "_verbatim": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_verbatim_line"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "PATTERN",
              "value": "[^\\r\\n]+"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "code": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_arrow_line"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_space"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "arrow"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "code_text"
              },
              {
                "type": "SYMBOL",
                "name": "anchor"
              },
              {
                "type": "SYMBOL",
                "name": "code_fence"
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_after_fence"
              },
              "named": true,
              "value": "prose"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "arrow": {
      "type": "STRING",
      "value": "=>"
    },
    "code_fence": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_code_fence_line"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_space"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "fence_marker"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_space"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "fence_label"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "fence_marker": {
      "type": "PATTERN",
      "value": "```+"
    },
    "fence_label": {
      "type": "PATTERN",
      "value": "[^\\s`][^\\r\\n]*"
    },
    "_after_fence": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_prose_line"
              },
              {
                "type": "REPEAT",
                "content": {
                  "type": "SYMBOL",
                  "name": "_prose_inline"
                }
              },
              {
                "type": "SYMBOL",
                "name": "_newline"
              }
            ]
          },
          {
            "type": "SYMBOL",
            "name": "_verbatim"
          },
          {
            "type": "SYMBOL",
            "name": "box"
          }
        ]
      }
    },
    "code_text": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_code_run"
            },
            {
              "type": "SYMBOL",
              "name": "_newline"
            },
            {
              "type": "SYMBOL",
              "name": "_code_line"
            }
          ]
        }
      }
    },
    "_text": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "[^`:{\\r\\n]+"
        },
        {
          "type": "PATTERN",
          "value": ":"
        },
        {
          "type": "PATTERN",
          "value": "\\{"
        }
      ]
    },
    "_code_span": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "`[^`\\r\\n]*`"
        },
        {
          "type": "PATTERN",
          "value": "`"
        }
      ]
    },
    "_code_run": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "[^:\\r\\n]+"
        },
        {
          "type": "PATTERN",
          "value": ":"
        }
      ]
    },
    "anchor": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "::["
          },
          "named": true,
          "value": "anchor_open"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "name"
          }
        },
        {
          "type": "STRING",
          "value": "]"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "target",
              "content": {
                "type": "SYMBOL",
                "name": "target"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "specifier",
              "content": {
                "type": "SYMBOL",
                "name": "anchor_specifier"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "name": {
      "type": "PATTERN",
      "value": "[^\\]\\r\\n]+"
    },
    "target": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "\\([^)\\r\\n]*\\)"
        }
      }
    },
    "anchor_specifier": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_anchor_brace"
          },
          "named": false,
          "value": "{"
        },
        {
          "type": "SYMBOL",
          "name": "_braced"
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "_anchor_brace": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "STRING",
          "value": "{"
        }
      }
    },
    "_braced": {
      "type": "CHOICE",
      "members": [
        {
          "type": "FIELD",
          "name": "label",
          "content": {
            "type": "SYMBOL",
            "name": "label"
          }
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "parameter"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SEQ",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_space"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "parameter"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "parameter": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "key",
          "content": {
            "type": "SYMBOL",
            "name": "parameter_key"
          }
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "parameter_value"
              },
              {
                "type": "SYMBOL",
                "name": "parameter_list"
              }
            ]
          }
        }
      ]
    },
    "parameter_key": {
      "type": "PATTERN",
      "value": "[A-Za-z_][A-Za-z0-9_-]*="
    },
    "parameter_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "\"([^\"\\\\\\r\\n]|\\\\.)*\""
        },
        {
          "type": "PATTERN",
          "value": "[A-Za-z0-9_.-]+"
        }
      ]
    },
    "parameter_list": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_space"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "parameter_value"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "CHOICE",
