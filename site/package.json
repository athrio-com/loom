{
  "name": "loom-website",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "weave:docs": "bunx @athrio/loom weave ../docs/index.loom src/docs.woven.json",
    "content": "bun run weave:docs",
    "predev": "bun run content",
    "dev": "bunx --bun vite build --watch & build=$!; trap 'kill $build' EXIT; bun --watch src/server.ts",
    "prebuild": "bun run content",
    "build": "bunx --bun vite build",
    "serve": "bun src/server.ts",
    "preview": "bun run build && bun run serve"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.5",
    "effect": "4.0.5",
    "foldkit": "0.168.0",
    "marked": "^18.0.5"
  },
  "devDependencies": {
    "vite": "^8.1.3"
  }
}
